# Store the actual file at /etc/realmsnetwork-map/map.env on the EU Debian VPS.
# Never commit real API keys, MCP bearer tokens, or other credentials.

# Multi-panel setup. Enter valid JSON; every panel key stays on the server.
MAP_PANELS_JSON=[{"id":"byteproject","name":"ByteProject","base_url":"https://your-authorized-panel.example","client_api_key":"REPLACE_WITH_CLIENT_API_KEY","application_api_key":"REPLACE_WITH_APPLICATION_API_KEY","admin_api_key":"REPLACE_WITH_ROOT_ADMIN_CLIENT_API_KEY"}]

# If you only want a single configured panel, remove MAP_PANELS_JSON and use these instead:
# PANEL_NAME=ByteProject
# PANEL_BASE_URL=https://your-authorized-panel.example
# PANEL_CLIENT_API_KEY=REPLACE_WITH_CLIENT_API_KEY
# PANEL_APPLICATION_API_KEY=REPLACE_WITH_APPLICATION_API_KEY
# PANEL_ADMIN_API_KEY=REPLACE_WITH_ROOT_ADMIN_CLIENT_API_KEY

CURL_CFFI_IMPERSONATE=chrome
MAP_HOST=127.0.0.1
MAP_PORT=8765
MAP_MAX_RESPONSE_CHARS=200000
MAP_MAX_INLINE_FILE_BYTES=6000000
# Add exact HTTPS node/Wings hostnames returned by the panel's file upload/download URL API.
# Example: MAP_TRUSTED_WINGS_HOSTS=node1.example.net,node2.example.net
MAP_TRUSTED_WINGS_HOSTS=
MAP_LOG_LEVEL=info

# Only needed if binding MAP directly to a non-loopback interface.
# Generate a random token locally with: openssl rand -hex 32
# MAP_HOST=0.0.0.0
# MAP_MCP_BEARER_TOKEN=SET_A_RANDOM_TOKEN_OF_AT_LEAST_32_CHARACTERS
