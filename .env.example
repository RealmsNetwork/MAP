# Local development example only. Never commit real API keys, passwords, or bearer tokens.
# AMP uses username/password session login (not an API key); use HTTPS and a least-privilege account.
MAP_PANELS_JSON=[{"id":"legacy-ptero","name":"Pterodactyl 1.x example","provider":"pterodactyl","panel_version":"1.x","base_url":"https://ptero.example.net","client_api_key":"REPLACE_WITH_CLIENT_API_KEY","application_api_key":"REPLACE_WITH_APPLICATION_API_KEY"},{"id":"calagopus","name":"Calagopus example","provider":"calagopus","base_url":"https://calagopus.example.net","api_base_path":"/api","api_key":"REPLACE_WITH_CALAGOPUS_API_KEY","auth_type":"bearer"},{"id":"mcsm","name":"MCSManager 10 example","provider":"mcsmanager","panel_version":"10.x","base_url":"https://mcsm.example.net","api_base_path":"/api","api_key":"REPLACE_WITH_MCSMANAGER_API_KEY","auth_type":"query","auth_query_param":"apikey"},{"id":"amp","name":"CubeCoders AMP example","provider":"amp","base_url":"https://amp.example.net","api_base_path":"/API","auth_type":"amp_session","auth_username":"REPLACE_WITH_AMP_SERVICE_USER","auth_password":"REPLACE_WITH_AMP_PASSWORD"},{"id":"custom-rest","name":"Custom REST panel example","provider":"generic_rest","base_url":"https://api.example.net","api_base_path":"/api/v2","api_key":"REPLACE_WITH_PANEL_TOKEN","auth_type":"bearer"}]

MAP_TRANSPORT=http
MAP_SERVER_NAME=Model Access Panel (MAP)
MAP_HOST=127.0.0.1
MAP_PORT=8765
# Non-loopback HTTP binds require a random token >=32 characters. Use: openssl rand -hex 32
# MAP_MCP_BEARER_TOKEN=
CURL_CFFI_IMPERSONATE=chrome
MAP_MAX_RESPONSE_CHARS=200000
MAP_MAX_REQUEST_BODY_BYTES=2000000
MAP_MAX_RESPONSE_BYTES=5000000
MAP_MAX_INLINE_FILE_BYTES=6000000
# Exact HTTPS Wings/node hostnames only; no wildcard patterns.
MAP_TRUSTED_WINGS_HOSTS=
MAP_LOG_LEVEL=info

# Legacy single-panel compatibility (used only if multi-panel variables are empty; supports Pterodactyl/Pelican):
# PANEL_NAME=Example Panel
# PANEL_BASE_URL=https://panel.example.net
# PANEL_CLIENT_API_KEY=REPLACE_WITH_CLIENT_API_KEY
# PANEL_APPLICATION_API_KEY=REPLACE_WITH_APPLICATION_API_KEY
# PANEL_ADMIN_API_KEY=REPLACE_WITH_ROOT_ADMIN_CLIENT_API_KEY
