# Local development example only. Never commit real API keys or bearer tokens.
MAP_PANELS_JSON=[{"id":"panel-one","name":"Example Panel One","base_url":"https://panel-one.example.net","client_api_key":"REPLACE_WITH_CLIENT_API_KEY","application_api_key":"REPLACE_WITH_APPLICATION_API_KEY","admin_api_key":"REPLACE_WITH_ROOT_ADMIN_CLIENT_API_KEY"},{"id":"panel-two","name":"Example Panel Two","base_url":"https://panel-two.example.net","client_api_key":"REPLACE_WITH_CLIENT_API_KEY","application_api_key":"","admin_api_key":""}]

MAP_TRANSPORT=http
MAP_SERVER_NAME=Model Access Panel (MAP)
MAP_HOST=127.0.0.1
MAP_PORT=8765
# Non-loopback HTTP binds require a random token >=32 characters. Use: openssl rand -hex 32
# MAP_MCP_BEARER_TOKEN=
CURL_CFFI_IMPERSONATE=chrome
MAP_MAX_RESPONSE_CHARS=200000
MAP_MAX_REQUEST_BODY_BYTES=2000000
MAP_MAX_RESPONSE_BYTES=5000000
MAP_MAX_INLINE_FILE_BYTES=6000000
# Exact HTTPS Wings/node hostnames only; no wildcard patterns.
MAP_TRUSTED_WINGS_HOSTS=
MAP_LOG_LEVEL=info

# Legacy single-panel compatibility (used only if multi-panel variables are empty):
# PANEL_NAME=Example Panel
# PANEL_BASE_URL=https://panel.example.net
# PANEL_CLIENT_API_KEY=REPLACE_WITH_CLIENT_API_KEY
# PANEL_APPLICATION_API_KEY=REPLACE_WITH_APPLICATION_API_KEY
# PANEL_ADMIN_API_KEY=REPLACE_WITH_ROOT_ADMIN_CLIENT_API_KEY
